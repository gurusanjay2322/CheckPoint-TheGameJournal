PORT=3000
DATABASE_URL=postgres://postgres:password@db.supabase.co:5432/postgres
REDIS_URL=redis://127.0.0.1:6379/0
STEAM_API_KEY=your_steam_api_key
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_SECRET=your_igdb_secret
# At least 32 characters; generate with: openssl rand -hex 32
JWT_SECRET=

# Externally reachable API base URL; Steam sign-in redirects back here.
PUBLIC_URL=http://localhost:3000
# Where the Steam callback sends the user (the app's deep link).
APP_REDIRECT_URL=checkpoint://auth

# Behind a load balancer: header with the real client IP, and the proxy
# IPs/CIDRs allowed to set it (comma-separated).
PROXY_HEADER=
TRUSTED_PROXIES=

# Default Steam store region for deal/wishlist prices (ISO country code).
STEAM_STORE_COUNTRY=IN
